# The UI opens with clearly labelled sample data by default.
# Set false to start against the real API instead.
VITE_DEMO_MODE=true

# Development: leave VITE_API_URL empty and use the same-origin Vite proxy.
VITE_API_URL=
API_PROXY_TARGET=http://localhost:5288

# Production: serve /api behind a reverse proxy or set VITE_API_URL to an
# HTTPS API origin that explicitly allows the frontend origin through CORS.
